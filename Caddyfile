# Caddyfile for Bedrock WordPress on FrankenPHP
# Coolify/Traefik handles TLS termination — we listen on plain HTTP inside the container

{
    auto_https off
    admin off
}

:80 {
    root * /var/www/html/web

    php_server {
        worker /var/www/html/web/index.php
    }

    # Serve static files directly — skip PHP for anything that exists on disk
    @static {
        file
        not path /wp-admin/*
    }
    route @static {
        file_server
    }

    # Block direct access to sensitive Bedrock files
    @blocked {
        path /.env
        path /.env.*
        path /composer.json
        path /composer.lock
        path /config/*
        path /vendor/*
        path /web/wp/wp-config.php
    }
    respond @blocked 403

    # WordPress pretty permalinks
    @wordpress {
        not file
        path_regexp ^(.+\.php)?$
    }
    rewrite @wordpress /index.php?{query}

    file_server
}

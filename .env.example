# ─── Environment ─────────────────────────────────────────────────────────────
# Options: development | staging | production
WP_ENV=production

# ─── URLs ─────────────────────────────────────────────────────────────────────
WP_HOME=https://yourdomain.com
WP_SITEURL=https://yourdomain.com/wp

# ─── Database ─────────────────────────────────────────────────────────────────
# In Coolify: use the service name as DB_HOST (e.g. "mysql")
DB_NAME=wordpress
DB_USER=wp
DB_PASSWORD=changeme
DB_HOST=mysql
DB_PREFIX=wp_

# ─── Auth Keys & Salts ────────────────────────────────────────────────────────
# Generate fresh values at: https://roots.io/salts
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# ─── Bunny.net Object Storage ─────────────────────────────────────────────────
# Create a storage zone at: https://dash.bunny.net/storage
# Primary region: Falkenstein (same DC as Hetzner server)
# Replicate to:   Johannesburg (for Zambia users)

# Your storage zone name
S3_UPLOADS_BUCKET=your-storage-zone-name

# Bunny S3 endpoint — match the prefix to your storage zone's primary region.
# Falkenstein: de-s3.storage.bunnycdn.com
# New York:    ny-s3.storage.bunnycdn.com
# Los Angeles: la-s3.storage.bunnycdn.com
# Singapore:   sg-s3.storage.bunnycdn.com
S3_UPLOADS_ENDPOINT=https://de-s3.storage.bunnycdn.com

# Region code — should match the endpoint prefix (de for de-s3, ny for ny-s3, ...)
# Used by the AWS SDK for SigV4 signing; Bunny validates against this.
S3_UPLOADS_REGION=de

# Storage zone password (from Bunny dashboard → Storage Zone → FTP & API Access)
S3_UPLOADS_KEY=your-storage-zone-name
S3_UPLOADS_SECRET=your-storage-zone-password

# Your Bunny CDN Pull Zone URL — media files are served from here
# Format: https://yourpullzone.b-cdn.net
# Or your custom CDN domain: https://cdn.yourdomain.com
S3_UPLOADS_BUCKET_URL=https://yourpullzone.b-cdn.net

# ─── Redis (optional but recommended) ────────────────────────────────────────
# In Coolify: add Redis as a service, use its service name as host
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── File modifications ──────────────────────────────────────────────────────
# Bedrock locks plugin/theme installs via the WP UI in production (Composer
# owns dependencies). Set DISALLOW_FILE_MODS=false in Coolify temporarily to
# run Starter Templates / similar one-shot imports, then flip back to default.
# Unset = default behaviour (true in production, false elsewhere).
# DISALLOW_FILE_MODS=false

# ─── Multisite (optional) ────────────────────────────────────────────────────
# Subdomain network for testing themes side by side. Two-phase enable:
#   Phase 1: WP_ALLOW_MULTISITE=true → deploy → wp-admin Tools ▸ Network Setup.
#   Phase 2: add MULTISITE=true + DOMAIN_CURRENT_SITE → deploy.
# DOMAIN_CURRENT_SITE is the bare main-site host (e.g. example.com); subsites are
# subdomains of it (theme-a.example.com). Leave all blank for single-site.
WP_ALLOW_MULTISITE=
MULTISITE=
DOMAIN_CURRENT_SITE=
PATH_CURRENT_SITE=/
SITE_ID_CURRENT_SITE=1
BLOG_ID_CURRENT_SITE=1

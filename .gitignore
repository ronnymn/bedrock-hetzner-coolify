# Bedrock
.env
.env.*
!.env.example

# WordPress core — managed by Composer, never committed
web/wp/

# Vendor — installed by Composer on deploy
vendor/

# Composer-managed plugins and mu-plugins — never committed.
# Exception: our own hand-written mu-plugins (prefixed `0`) ARE tracked.
# The leading `!web/app/mu-plugins/` re-includes the dir so the more
# specific `!.../0*.php` pattern below it can take effect.
web/app/plugins/
web/app/mu-plugins/*
!web/app/mu-plugins/0*.php

# Composer-managed themes — never committed (matches plugins pattern).
web/app/themes/*
!web/app/themes/.gitkeep

# Uploads — stored in Bunny.net + persisted via Coolify volume on prod.
# Keep dir tracked so image has it owned by www-data (volume inherits perms).
web/app/uploads/*
!web/app/uploads/.gitkeep

# WP upgrade temp dir — persisted via Coolify volume on prod.
web/app/upgrade/*
!web/app/upgrade/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Caddyfile for Bedrock WordPress on FrankenPHP
# Worker mode disabled while debugging

{
    auto_https off
    admin off
}

:80 {
    root * /var/www/html/web

    @static {
        file
        not path /wp-admin/*
    }
    route @static {
        file_server
    }

    @blocked {
        path /.env
        path /.env.*
        path /composer.json
        path /composer.lock
        path /config/*
        path /vendor/*
        path /web/wp/wp-config.php
    }
    respond @blocked 403

    @wordpress {
        not file
        path_regexp ^(.+\.php)?$
    }
    rewrite @wordpress /index.php?{query}

    php_server

    file_server
}

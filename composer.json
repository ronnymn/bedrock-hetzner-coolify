{
  "name": "your-org/your-project",
  "type": "project",
  "license": "MIT",
  "description": "Bedrock WordPress — Hetzner + Coolify + Bunny.net",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    },
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com",
      "only": [
        "wpengine/advanced-custom-fields-pro"
      ]
    }
  ],
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.2",
    "vlucas/phpdotenv": "^5.5",
    "oscarotero/env": "^2.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "^6.5",
    "roots/wp-config": "^1.0.0",
    "roots/wp-password-bcrypt": "^1.1.0",
    "humanmade/s3-uploads": "^3.0",
    "wpackagist-plugin/redis-cache": "^2.5",
    "wpackagist-plugin/autoptimize": "^3.1",
    "wpackagist-plugin/wp-fastest-cache": "^1.2"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Bedrock\\Autoloader::dump"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
